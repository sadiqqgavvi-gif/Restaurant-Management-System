PORT=5000

# Leave MONGO_URI empty in development: the server starts an in-memory MongoDB automatically.
# For data that persists, use a local or Atlas connection string, e.g.
#   MONGO_URI=mongodb://127.0.0.1:27017/ember
#   MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ember
MONGO_URI=

JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@ember.com
ADMIN_PASSWORD=admin123
